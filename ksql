CREATE STREAM stream1 (key STRING, value STRING) WITH (KAFKA_TOPIC='video-stream-1', VALUE_FORMAT='JSON');
CREATE STREAM stream2 (key STRING, value STRING) WITH (KAFKA_TOPIC='video-stream-2', VALUE_FORMAT='JSON');
CREATE STREAM stream3 (key STRING, value STRING) WITH (KAFKA_TOPIC='video-stream-3', VALUE_FORMAT='JSON');

CREATE STREAM combined_stream AS
    SELECT * FROM stream1
    UNION ALL
    SELECT * FROM stream2
    UNION ALL
    SELECT * FROM stream3;